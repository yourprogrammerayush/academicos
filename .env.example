# AcademicOS — environment variables (copy to .env.local for local dev)
# NEVER commit .env.local to GitHub. All secrets stay server-side only.

# --- Google Drive (optional but recommended for live catalog) ---
# Master folder: MATERIALS BY AYUSH JHA, 2CSE-4
# Create a restricted API key in Google Cloud Console (Drive API enabled).
# Files must be shared as "Anyone with the link can view" for key-based access,
# OR use a Service Account + share the folder with it.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=1WqBC4aCKdxNm14HIshBSwV-080svsNGC
# Optional: service account JSON (single line) for private folders
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Groq AI (primary engine) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# --- Auth (optional — app runs in Guest Mode without these) ---
# Clerk (recommended free tier)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Supabase (alternative)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (bot protection on auth forms) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
